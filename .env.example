# ============================================================================
# CROWDNEXIS_AI: AI-Based Crowd Risk & Missing Person Detection System
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env with real secrets to version control

# ============================================================================
# PROJECT
# ============================================================================
PROJECT_NAME=CrowdNexis AI Crowd Risk Detection
DEBUG_MODE=false
LOG_LEVEL=info

# ============================================================================
# SERVER
# ============================================================================
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# ============================================================================
# POSTGRESQL (15+ with pgvector extension)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=missing_persons
DB_USER=postgres
DB_PASSWORD=postgres123
DB_SSLMODE=prefer
DB_MIN_CONN=2
DB_MAX_CONN=10

# ============================================================================
# REDIS (BullMQ queue + Socket.io adapter)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=8h
ALLOW_REGISTRATION=false

# ============================================================================
# PYTHON AI ENGINE
# ============================================================================
# YOLO Model Configuration
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_DEVICE=cuda:0

# Risk Classification Thresholds (people count per frame)
SAFE_THRESHOLD=10
MODERATE_THRESHOLD=25
RISKY_THRESHOLD=50

# Face Recognition (InsightFace buffalo_l)
FACE_MATCH_THRESHOLD=0.60
INSIGHTFACE_MODEL=buffalo_l

# Performance Settings
TARGET_FPS=15
FRAME_WIDTH=640
FRAME_HEIGHT=480
SKIP_FRAMES_CROWD=3
SKIP_FRAMES_FACE=6

# ============================================================================
# FILE UPLOAD
# ============================================================================
UPLOAD_DIR=data/uploads
RESULTS_DIR=data/results
LOGS_DIR=data/logs
MAX_FILE_SIZE=500000000

# ============================================================================
# NOTIFICATIONS
# ============================================================================
# Email (SMTP - Mailtrap for testing)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-user
SMTP_PASS=your-mailtrap-password
ALERT_EMAIL_TO=alerts@example.com

# WhatsApp + SMS (Twilio - optional, currently stubbed)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM=+1234567890
ALERT_PHONE_TO=+1234567890

# ============================================================================
# FACE RECOGNITION API (FastAPI Microservice)
# ============================================================================
FACE_API_URL=http://localhost:5001
FACE_API_TIMEOUT=30000

# ============================================================================
# CROWD MANAGEMENT THRESHOLDS
# ============================================================================
CROWD_CAPACITY=40
OCCUPANCY_CRITICAL_THRESHOLD=110
OCCUPANCY_RISKY_THRESHOLD=95
OCCUPANCY_MODERATE_THRESHOLD=80

# ============================================================================
# VIDEO SOURCE (Optional - for live RTSP streams)
# ============================================================================
DEFAULT_VIDEO_SOURCE=0
RTSP_URL=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_VOICE_ALERTS=false
ENABLE_CROWD_HEATMAP=true
ENABLE_FACE_MATCHING=true
ENABLE_NOTIFICATIONS=true
ENABLE_EMAIL_ALERTS=true
ENABLE_SMS_ALERTS=false
ENABLE_WHATSAPP_ALERTS=false

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================
DEBUG_VERBOSE=false
SHOW_REALTIME_DISPLAY=false
SAVE_OUTPUT_VIDEO=true

# ============================================================================
# HARDWARE SPECIFICATIONS (RTX 3050 Ti optimized)
# ============================================================================
# Device: RTX 3050 Ti, 4GB VRAM
# Memory: 24GB RAM
# Storage: 1TB SSD
# OS: Windows 11 / Ubuntu 22.04
# CUDA: 11.8
# cuDNN: 8.7+
