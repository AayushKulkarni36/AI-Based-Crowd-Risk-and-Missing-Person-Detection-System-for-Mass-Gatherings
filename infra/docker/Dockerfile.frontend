FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY frontend_v2/package*.json ./

# Install dependencies
RUN npm ci

# Copy application code
COPY frontend_v2/src ./src
COPY frontend_v2/public ./public
COPY frontend_v2/*.ts* ./
COPY frontend_v2/*.js* ./
COPY frontend_v2/index.html ./

# Expose port
EXPOSE 5173

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://localhost:5173/ || exit 1

# Start development server
CMD ["npm", "run", "dev"]
