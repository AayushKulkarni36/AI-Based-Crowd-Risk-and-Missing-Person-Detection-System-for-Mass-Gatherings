FROM nvidia/cuda:11.8.0-runtime-ubuntu22.04

WORKDIR /app

# Install Python 3.11 and dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3.11-dev \
    python3-pip \
    git \
    libsm6 \
    libxext6 \
    libxrender-dev \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create Python 3.11 virtual environment
RUN python3.11 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Copy requirements and install Python dependencies
COPY requirements.txt .

RUN pip install --no-cache-dir \
    fastapi==0.110.1 \
    uvicorn[standard]==0.27.0 \
    asyncpg==0.30.0 \
    pgvector==0.3.1

# Install ML/CV stack
RUN pip install --no-cache-dir \
    torch==2.0.0 \
    torchvision==0.15.0 \
    opencv-python==4.12.0.88 \
    numpy==2.2.6 \
    Pillow==10.4.0 \
    scipy==1.16.3

# Install YOLOv8
RUN pip install --no-cache-dir \
    ultralytics==8.3.227

# Install InsightFace and ONNX Runtime GPU
RUN pip install --no-cache-dir \
    insightface==0.7.3 \
    onnxruntime-gpu==1.19.2

# Install FAISS (GPU version)
RUN pip install --no-cache-dir faiss-gpu==1.8.0 || pip install --no-cache-dir faiss-cpu==1.8.0

# Copy application code
COPY src/ ./src/

# Create required directories
RUN mkdir -p data/uploads data/results data/logs

# Expose port
EXPOSE 5001

# Health check
HEALTHCHECK --interval=15s --timeout=10s --retries=5 \
    CMD curl -f http://localhost:5001/health || exit 1

# Start FastAPI server
CMD ["uvicorn", "src.face_recognition.face_api:app", "--host", "0.0.0.0", "--port", "5001", "--workers", "1"]
